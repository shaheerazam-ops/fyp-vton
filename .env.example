# Local integration test
VTON_MODEL=demo
VTON_DEVICE=cpu

# High-quality IDM-VTON (CUDA/NVIDIA machine)
# VTON_MODEL=pretrained
# VTON_DEVICE=cuda
IDM_VTON_MODEL=yisol/IDM-VTON
IDM_VTON_SOURCE=third_party/IDM-VTON
IDM_VTON_CPU_OFFLOAD=0
VTON_STEPS=30
VTON_GUIDANCE=2.0

# Infra
DATABASE_URL=postgresql://localhost/vton
REDIS_URL=redis://localhost:6379/0
STORAGE_BUCKET=vton-platform-images
